# Copy to .env for local development and Docker --env-file.
# A blank key enables Echo mode only. Never commit a real API key.
PORT=8080
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Separate text model used after a completed AI call.
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# Automatically end inactive calls after this many seconds (10-3600).
CALL_IDLE_TIMEOUT_SECONDS=60
# Optional: defaults to 127.0.0.1 locally; Docker sets 0.0.0.0.
# CALLIO_BIND_HOST=127.0.0.1

# Structured JSON log level: debug, info (default), warn, error.
LOG_LEVEL=info
