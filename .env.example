# Copy this file to .env; .env is ignored by Git.
PORT=8080
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-live
# First greeting only; subsequent replies follow the caller's language.
# Supported: fr-FR, en-US, ko-KR. Default if omitted: fr-FR.
CALL_GREETING_LOCALE=ko-KR

# Automatically complete a live call after conversational inactivity (10-3600 seconds).
CALL_IDLE_TIMEOUT_SECONDS=60
